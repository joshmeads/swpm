{
  "name": "@joshmeads/swpm",
  "version": "2.9.3",
  "engines": {
    "node": ">=16"
  },
  "description": "Switch Package Manager",
  "main": "bin/src/cli/swpm.js",
  "bin": {
    "swpm": "bin/src/cli/swpm.js",
    "swpx": "bin/src/cli/swpx.js",
    "si": "bin/src/alias/si.js",
    "sif": "bin/src/alias/sif.js",
    "sa": "bin/src/alias/sa.js",
    "sae": "bin/src/alias/sae.js",
    "sad": "bin/src/alias/sad.js",
    "sade": "bin/src/alias/sade.js",
    "sag": "bin/src/alias/sag.js",
    "srm": "bin/src/alias/srm.js",
    "srg": "bin/src/alias/srg.js",
    "sup": "bin/src/alias/sup.js",
    "sug": "bin/src/alias/sug.js",
    "sui": "bin/src/alias/sui.js",
    "soe": "bin/src/alias/soe.js",
    "sgr": "bin/src/alias/sgr.js",
    "sgb": "bin/src/alias/sgb.js",
    "sgp": "bin/src/alias/sgp.js",
    "sgm": "bin/src/alias/sgm.js",
    "sgd": "bin/src/alias/sgd.js",
    "soc": "bin/src/alias/soc.js",
    "son": "bin/src/alias/son.js",
    "scr": "bin/src/alias/scr.js",
    "scn": "bin/src/alias/scn.js",
    "scl": "bin/src/alias/scl.js",
    "scb": "bin/src/alias/scb.js",
    "scd": "bin/src/alias/scd.js",
    "scc": "bin/src/alias/scc.js",
    "sca": "bin/src/alias/sca.js",
    "scf": "bin/src/alias/scf.js",
    "sci": "bin/src/alias/sci.js",
    "sr": "bin/src/alias/sr.js",
    "sp": "bin/src/alias/sp.js",
    "spn": "bin/src/alias/spn.js",
    "spy": "bin/src/alias/spy.js",
    "spyb": "bin/src/alias/spyb.js",
    "spp": "bin/src/alias/spp.js",
    "spb": "bin/src/alias/spb.js",
    "sx": "bin/src/alias/sx.js"
  },
  "scripts": {
    "prebuild": "rm -rf bin/",
    "build": "tsc --project tsconfig.build.json",
    "postbuild": "cp package*.json .npmignore README.md LICENSE.md CHANGELOG.md bin && (cd bin && npm ci --omit=dev --ignore-scripts)",
    "pack": "npm pack bin/ --pack-destination=\"bin/\"",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --fix --ext .js,.ts",
    "test": "vitest --run --reporter verbose --pool=forks",
    "test:w": "vitest --pool=forks",
    "test:c": "vitest run --coverage --pool=forks",
    "test:wc": "vitest watch --coverage --pool=forks",
    "test:ui": "vitest -ui",
    "ts:check": "tsc --noEmit",
    "ts:diagnostics": "tsc --extendedDiagnostics",
    "ts:trace": "tsc --traceResolution",
    "prerelease": "npm run build",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deinsoftware/swpm.git"
  },
  "keywords": [
    "swpm",
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "cli",
    "command-line",
    "package-manager"
  ],
  "contributors": [
    "joshmeads",
    "equiman"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joshmeads/swpm/issues"
  },
  "homepage": "https://github.com/joshmeads/swpm#readme",
  "type": "module",
  "dependencies": {
    "chalk": "5.3.0",
    "command-exists": "1.2.9",
    "common-tags": "1.8.2",
    "find-up": "7.0.0",
    "open": "10.0.1",
    "prompts": "2.4.2",
    "semver": "7.5.4",
    "spinnies": "0.5.1",
    "update-notifier": "7.0.0",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@types/command-exists": "1.2.3",
    "@types/common-tags": "1.8.4",
    "@types/prompts": "2.4.9",
    "@types/semver": "7.5.6",
    "@types/spinnies": "0.5.3",
    "@types/update-notifier": "6.0.8",
    "@types/yargs": "17.0.32",
    "@typescript-eslint/eslint-plugin": "6.16.0",
    "@typescript-eslint/parser": "6.16.0",
    "@vitest/coverage-v8": "1.1.0",
    "eslint": "8.56.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "16.5.0",
    "eslint-plugin-promise": "6.1.1",
    "release-it": "^17.4.1",
    "type-fest": "4.8.3",
    "typescript": "5.3.3",
    "vitest": "1.1.0"
  },
  "volta": {
    "node": "22.3.0",
    "npm": "10.2.1",
    "yarn": "1.22.22"
  },
  "packageManager": "npm@10.2.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin"
  ]
}
